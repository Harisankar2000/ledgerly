NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

DATABASE_URL=postgresql://ledgerly:ledgerly@localhost:5434/ledgerly
REDIS_URL=redis://localhost:6381
KAFKA_BROKERS=localhost:29092
KAFKA_TOPIC=ledger.events

# Comma-separated API keys. Leave empty to disable authentication (local development only).
API_KEYS=dev-ledger-key
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
RATE_LIMIT_MAX=300

OUTBOX_POLL_INTERVAL_MS=500
WEBHOOK_MAX_ATTEMPTS=6
